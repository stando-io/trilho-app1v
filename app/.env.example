# Frontend Environment Variables
# Copy to .env.local for local development (not committed)
# In Vercel, add these in Project Settings > Environment Variables

# API Backend URL (Render)
VITE_API_URL=https://trilho-api.onrender.com

# WebSocket Backend URL (Render)
VITE_WS_URL=wss://trilho-api.onrender.com

# Supabase (if frontend uses Supabase directly)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key