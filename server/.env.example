# Copie para .env e ajuste. Nunca commite o .env.

# Porta da API
PORT=4000

# Banco de sistema
DATABASE_URL=postgres://trilho:trilho_local@localhost:5432/trilho_system

# Segredo da sessao (obrigatorio em producao; gere com: openssl rand -hex 32)
SESSION_SECRET=troque-este-valor-em-producao

# true apenas apos terminacao TLS (proxy reverso)
COOKIE_SECURE=false

# Origem do frontend para CORS
BASE_URL=http://localhost:5173

# Ambiente: development | production
NODE_ENV=development

# Bootstrap do administrador inicial (so na primeira execucao do seed)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@trilho.local
ADMIN_PASSWORD=
